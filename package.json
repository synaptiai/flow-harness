{
  "name": "@synapti/flow-harness",
  "version": "0.1.0-alpha.3",
  "description": "Provider-neutral coding-agent harness with deterministic workflow graphs, durable evidence, and fail-closed sandboxed execution",
  "keywords": [
    "agent-harness",
    "ai-agents",
    "coding-agents",
    "llm",
    "sandbox",
    "typescript",
    "workflow-engine"
  ],
  "author": "Synapti AI",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synaptiai/flow-harness.git"
  },
  "homepage": "https://github.com/synaptiai/flow-harness#readme",
  "bugs": {
    "url": "https://github.com/synaptiai/flow-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "flow": "dist/cli/launcher.js"
  },
  "exports": {},
  "files": [
    "compatibility",
    "dist",
    "docs",
    "examples",
    "prime-container",
    "proof-container",
    "scripts/prepare-proof-runtime.mjs",
    "LICENSE",
    "npm-shrinkwrap.json",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && node dist/cli/public-capability-reference.js --check && npm run test:runtime",
    "ci:local": "node scripts/ci-local.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "docs:capabilities:check": "npm run build && node dist/cli/public-capability-reference.js --check",
    "docs:capabilities:generate": "npm run build && node dist/cli/public-capability-reference.js --write",
    "docs:ste": "node scripts/check-docs-ste.mjs --changed",
    "docs:style": "node scripts/check-doc-style.mjs --all",
    "docs:links": "node scripts/check-doc-links.mjs --all",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "pack:check": "node scripts/verify-package.mjs",
    "prime:image:verify": "npm run build && node scripts/verify-prime-image.mjs",
    "proof:prepare": "npm run build && node scripts/prepare-proof-runtime.mjs",
    "proof:prepare:verify": "npm run build && node scripts/prepare-proof-runtime.mjs --verify-only",
    "proof:image:verify": "npm run proof:prepare:verify && npm run proof:runtime:test",
    "proof:runtime:test": "vitest run --config vitest.runtime.config.ts test/runtime/lean-proof-oci.runtime.test.ts",
    "release:prepare": "npm run build && node scripts/build-package-release.mjs",
    "release:verify": "node scripts/verify-package.mjs --release",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@anthropic-ai/sandbox-runtime": "0.0.70",
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@sigstore/bundle": "5.0.0",
    "@sigstore/protobuf-specs": "0.5.1",
    "@sigstore/verify": "4.1.2",
    "ajv": "8.20.0",
    "tuf-js": "6.0.0",
    "typebox": "1.3.7",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@oh-my-pi/pi-ai": "17.2.12",
    "@oh-my-pi/pi-coding-agent": "17.2.12",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "nanoid": "3.3.18",
    "sharp": "0.35.3"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "17.2.12",
    "@oh-my-pi/pi-coding-agent": "17.2.12"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  }
}
