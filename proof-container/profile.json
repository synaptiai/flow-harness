{
  "version": 1,
  "id": "lean-proof-v1",
  "platform": "linux/amd64",
  "imports": ["Mathlib"],
  "allowedAxioms": ["propext", "Quot.sound", "Classical.choice"],
  "refusedConstructs": [
    "sorry",
    "admit",
    "axiom",
    "unsafe",
    "partial",
    "run_tac",
    "initialize",
    "#eval",
    "Lean.trustCompiler"
  ],
  "policy": {
    "network": "none",
    "pidNamespace": "private",
    "ipcNamespace": "private",
    "cgroupNamespace": "private",
    "rootFilesystem": "read-only",
    "noNewPrivileges": true,
    "supervisorCapabilities": ["KILL", "SETUID"],
    "maskedPaths": [
      "/proc/acpi",
      "/proc/asound",
      "/proc/interrupts",
      "/proc/kcore",
      "/proc/keys",
      "/proc/latency_stats",
      "/proc/timer_list",
      "/proc/timer_stats",
      "/proc/sched_debug",
      "/proc/scsi",
      "/proc/cmdline",
      "/sys/class/dmi/id",
      "/sys/devices/virtual/dmi/id",
      "/sys/firmware",
      "/sys/devices/virtual/powercap"
    ],
    "readonlyPaths": ["/proc/bus", "/proc/fs", "/proc/irq", "/proc/sys", "/proc/sysrq-trigger"],
    "memoryMaxBytes": 8589934592,
    "memorySwapMaxBytes": 0,
    "cpuPeriodMicros": 100000,
    "cpuQuotaMicros": 200000,
    "pidsMax": 128,
    "workspaceBytes": 536870912,
    "workspaceInodes": 65536,
    "workspaceUid": 0,
    "workspaceGid": 10001,
    "workspaceMode": "0710",
    "openFilesMax": 512,
    "userProcessesMax": 128,
    "fileSizeMaxBytes": 268435456,
    "coreSizeMaxBytes": 0,
    "stopGraceSeconds": 2
  }
}
