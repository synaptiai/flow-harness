{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/specification/v0_9/common_types.json",
  "$comment": "Exact A2UI v0.9 definitions used by the Flow presentation profile. Source: https://github.com/a2ui-project/a2ui/blob/main/specification/v0_9/json/common_types.json",
  "$defs": {
    "ComponentId": {
      "type": "string"
    },
    "ComponentCommon": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        }
      },
      "required": ["id"]
    },
    "ChildList": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentId"
          }
        },
        {
          "type": "object",
          "properties": {
            "componentId": {
              "$ref": "#/$defs/ComponentId"
            },
            "path": {
              "type": "string"
            }
          },
          "required": ["componentId", "path"],
          "additionalProperties": false
        }
      ]
    }
  }
}
